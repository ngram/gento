{
  "name": "slidescraper",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3",

  "features": {
    // The container image is the point of this environment: web/Dockerfile
    // has to be buildable here.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // For the Cloudflare Worker and wrangler.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Two cores is plenty for this repo and halves the rate at which a
  // Codespace eats the free monthly allowance.
  "hostRequirements": { "cpus": 2 },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8080, 8787],
  "portsAttributes": {
    "8080": { "label": "demo web app" },
    "8787": { "label": "wrangler dev" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["Shopify.ruby-lsp", "esbenp.prettier-vscode"]
    }
  }
}
